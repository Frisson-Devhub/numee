{
  "name": "@numee/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"pnpm run dev:run\" --onFailure \"echo API compile failed\"",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "seed:catalog": "tsx prisma/seed-catalog.ts",
    "dev:run": "node ./scripts/run-dev.mjs"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@numee/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "@upstash/redis": "^1.36.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.13",
    "openai": "^6.18.0",
    "pg": "^8.17.2",
    "prisma": "^7.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "tsc-alias": "^1.9.1",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.7",
    "typescript": "^5.8.3"
  }
}
