# Database (apps/api) — matches docker-compose postgres defaults
DATABASE_URL=postgresql://numee:numee@localhost:5432/numee
# Optional unpooled URL for Nest when DATABASE_URL is a transaction pooler
# (e.g. Neon `*-pooler*`). Required for Prisma interactive `$transaction`.
# DIRECT_DATABASE_URL=postgresql://numee:numee@localhost:5432/numee

# Auth (apps/api)
JWT_SECRET=change-me-in-production

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
CANDIDATE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
RECRUITER_URL=http://localhost:3003
API_URL=http://localhost:3001

# CORS origins (comma-separated, apps/api)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# Vite admin
VITE_API_URL=
VITE_CANDIDATE_URL=http://localhost:3000

# SMTP (apps/api)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Upstash Redis REST (apps/api) — OTP / signup sessions only
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protocol Redis for BullMQ (apps/api) — local via docker-compose
REDIS_URL=redis://127.0.0.1:6379

# Qdrant vector DB (apps/api) — local via docker-compose, or Cloud URL + API key
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=

# Cloudinary (apps/api)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (apps/api)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# OpenAI / Anam / agents (apps/api)
OPENAI_API_KEY=
ANAM_API_KEY=
AI_AGENT_URL=
AGENTS_BASE_URL=
VIRTUAL_ASSISTANT_DISPATCH_PATH=virtual_assistant/dispatch-assistant

# Assessment concurrency (apps/api)
# Candidates allowed in a live assessment at once; the rest wait in a queue.
ASSESSMENT_MAX_ACTIVE=25
# Seconds a live slot survives without a heartbeat. This, not the release call, is what
# frees a seat when a tab is closed or a browser crashes.
ASSESSMENT_ACTIVE_TTL_SECONDS=90
# Seconds a queued candidate survives without polling before leaving the queue.
ASSESSMENT_WAITING_TTL_SECONDS=30
