{
  "name": "numee",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "sh -c 'turbo run dev --filter=@numee/candidate --filter=@numee/api --filter=@numee/admin --filter=@numee/recruiter'",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @numee/api db:generate",
    "db:migrate": "pnpm --filter @numee/api db:migrate",
    "db:push": "pnpm --filter @numee/api db:push"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
